{
  "name": "donext",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @donext/web build && pnpm --filter @donext/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
